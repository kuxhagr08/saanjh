# APNA Environment Configuration Template

# Backend (Django 5.2 / Daphne ASGI)
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://apna.onrender.com

# Database (Leave unset for local SQLite dev)
# DATABASE_URL=postgresql://user:password@localhost:5432/apna

# Redis Channel Layer (Optional in dev, in-memory used if unset)
# REDIS_URL=redis://localhost:6379/0

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
